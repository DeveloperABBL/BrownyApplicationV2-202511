	"Auto JsonSerializable Class Generate": {
		"prefix": "classjson",
		"body": [
			"import 'package:json_annotation/json_annotation.dart';",
			"",
			"part '$2.g.dart';",
			"",
			"// **************************************************************************",
			"// เมื่อสร้าง class ของ JsonSerializable ใหม่ ให้ run command ใน terminal",
			"// dart run build_runner build --delete-conflicting-outputs",
			"// dart run build_runner watch (auto gen)",
			"// **************************************************************************",
			"",
			"@JsonSerializable()",
			"class $1 {",
			"",
			"\t\t",
			"",
			"\tfactory $1.fromJson(Map<String, dynamic> json) =>",
			"\t_$$1FromJson(json);",
			"\tMap<String, dynamic> toJson() => _$$1ToJson(this);",
			"}",
		]
	},
	"Auto JsonSerializable Class Generate extend BaseModel": {
		"prefix": "classjsonbasemodel",
		"body": [
			"import 'package:json_annotation/json_annotation.dart';",
			"import 'package:browny_applications_new/core/data/remote/models/response/base_response.dart';",
			"",
			"part '$2.g.dart';",
			"",
			"// **************************************************************************",
			"// เมื่อสร้าง class ของ JsonSerializable ใหม่ ให้ run command ใน terminal",
			"// dart run build_runner build --delete-conflicting-outputs",
			"// dart run build_runner watch (auto gen)",
			"// **************************************************************************",
			"",
			"@JsonSerializable()",
			"class $1 extends BaseModelResponse {",
			"",
			"\t$1({",
			"\t\t\tsuper.success,",
			"\t\t\tsuper.errorType,",
			"\t\t\tsuper.message,",
			"\t});",
			"",
			"\tfactory $1.fromJson(Map<String, dynamic> json) =>",
			"\t_$$1FromJson(json);",
			"\tMap<String, dynamic> toJson() => baseToJson(_$$1ToJson(this));",
			"}",
		]
	},
